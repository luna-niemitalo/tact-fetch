 #pragma comment(lib, "ws2_32.lib")          // Internet functions for HTTP stream
 #endif
 
+// tact-fetch local patch (not upstream CascLib) -- see this repo's
+// DESIGN.md #9 and vendor/patches/README.md. HttpDownloadFile below is
+// swapped to fetch via libcurl instead of CascLib's own raw-socket
+// HTTP/1.1 client, so callers get HTTP/2 negotiation, TLS, a real
+// User-Agent and a real timeout; every other code path in this file
+// (CDN host/path selection, retry-across-hosts, local-cache-exists
+// check, disk write) is untouched.
+#include <curl/curl.h>
+#include <cstring>
+#include <ctime>
+#include <string>
+
+// tact-fetch's own DESIGN.md #5 politeness numbers, duplicated here
+// because this file builds as part of vendored CascLib, outside
+// tact-fetch's own src/politeness.h include path -- see that file for
+// the canonical values and the reasoning behind them.
+#define TACT_FETCH_HTTP_TIMEOUT_SECONDS 30L
+#define TACT_FETCH_USER_AGENT "tact-fetch/0.1 (+luna.niemitalo@gmail.com)"
+
+// Set after every libcurl attempt (success or failure) so tact-fetch's
+// own calling loop (src/fetch.cpp) can see the real HTTP status/headers
+// CascLib's DWORD error codes otherwise discard -- needed to honor a
+// 429/503 Retry-After per DESIGN.md #5 instead of always falling back to
+// generic backoff timing. Single-threaded fetch loop by design (#9), so
+// a plain global is enough; not thread-safe, deliberately.
+long g_tactFetchLastHttpStatus = 0;
+long g_tactFetchLastRetryAfterSeconds = 0;
+
+static size_t TactFetchCurlWrite(char * ptr, size_t size, size_t nmemb, void * userdata)
+{
+    std::string * pBuffer = (std::string *)userdata;
+    size_t cbAdded = size * nmemb;
+
+    pBuffer->append(ptr, cbAdded);
+    return cbAdded;
+}
+
+// Shared by HttpDownloadFile (bulk per-file "data" archive fetches) and
+// RibbitDownloadFile (the small one-time versions/cdns/buildconfig/
+// cdnconfig bootstrap an online storage handle needs before any per-file
+// fetch can happen) -- both were CascLib's own raw-socket HTTP/1.1
+// client before this patch, now both go through the same libcurl call
+// (HTTP/2, TLS, a real User-Agent, a real timeout).
+static bool TactFetchCurlGet(const char * szUrl, std::string & responseBody)
+{
+    CURL * curl = curl_easy_init();
+    if(curl == NULL)
+        return false;
+
+    curl_easy_setopt(curl, CURLOPT_URL, szUrl);
+    curl_easy_setopt(curl, CURLOPT_HTTP_VERSION, (long)CURL_HTTP_VERSION_2TLS);
+    curl_easy_setopt(curl, CURLOPT_USERAGENT, TACT_FETCH_USER_AGENT);
+    curl_easy_setopt(curl, CURLOPT_TIMEOUT, TACT_FETCH_HTTP_TIMEOUT_SECONDS);
+    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, TactFetchCurlWrite);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, (void *)&responseBody);
+
+    CURLcode res = curl_easy_perform(curl);
+
+    long httpStatus = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &httpStatus);
+    g_tactFetchLastHttpStatus = httpStatus;
+
+    g_tactFetchLastRetryAfterSeconds = 0;
+#if LIBCURL_VERSION_NUM >= 0x073900   // CURLINFO_RETRY_AFTER added in curl 7.57.0
+    curl_off_t retryAfter = 0;
+    if(curl_easy_getinfo(curl, CURLINFO_RETRY_AFTER, &retryAfter) == CURLE_OK)
+        g_tactFetchLastRetryAfterSeconds = (long)retryAfter;
+#endif
+
+    curl_easy_cleanup(curl);
+
+    // Ribbit's "versions"/"cdns" bootstrap files are served with no
+    // HTTP status at all in some CascLib-tested configurations (status
+    // 0) -- treat 0 as "unknown, trust curl's own success/fail" rather
+    // than a hard failure, but still reject real 4xx/5xx.
+    if(res != CURLE_OK)
+        return false;
+    if(httpStatus != 0 && (httpStatus < 200 || httpStatus >= 300))
+        return false;
+    return true;
+}
+
